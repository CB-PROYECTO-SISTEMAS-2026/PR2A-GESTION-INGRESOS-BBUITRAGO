{
  "name": "eventix-tests",
  "private": true,
  "description": "Pruebas automatizadas de Eventix (ver README.md)",
  "scripts": {
    "test": "npm run test:unit && npm run test:frontend && npm run test:integracion",
    "test:unit": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:frontend": "vitest run --config vitest.config.mjs",
    "test:frontend:watch": "vitest --config vitest.config.mjs",
    "test:integracion": "jest --selectProjects integracion --runInBand",
    "limpiar": "node scripts/limpiar-datos-prueba.js",
    "limpiar:confirmar": "node scripts/limpiar-datos-prueba.js --confirmar",
    "test:e2e": "playwright test",
    "test:e2e:ver": "playwright test --headed",
    "test:e2e:reporte": "playwright show-report e2e-reporte",
    "test:todo": "npm run test:unit && npm run test:frontend && npm run test:integracion && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jest": "^30.5.2",
    "jsdom": "^30.1.2",
    "ts-jest": "^29.4.14",
    "typescript": "~5.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
