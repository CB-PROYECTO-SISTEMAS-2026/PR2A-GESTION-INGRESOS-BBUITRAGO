{
  "name": "eventix-tests",
  "private": true,
  "description": "Pruebas automatizadas de Eventix (ver README.md)",
  "scripts": {
    "test": "npm run test:unit && npm run test:integracion",
    "test:unit": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:integracion": "jest --selectProjects integracion --runInBand",
    "limpiar": "node scripts/limpiar-datos-prueba.js",
    "limpiar:confirmar": "node scripts/limpiar-datos-prueba.js --confirmar"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "~5.7"
  }
}
