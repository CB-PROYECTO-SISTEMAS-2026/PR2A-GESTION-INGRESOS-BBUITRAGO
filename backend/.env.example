# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# MySQL: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="mysql://usuario:contraseña@127.0.0.1:3306/eventix"

# Genera uno propio (mínimo 32 caracteres), por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

PORT=3000
# Zona horaria usada para validar que las fechas no sean anteriores a hoy.
APP_TIMEZONE="America/La_Paz"
# "true" solo si la API corre detrás de un proxy/balanceador (necesario para el rate limit por IP).
TRUST_PROXY="false"

# URL pública del frontend (se usa en los enlaces de los correos).
FRONTEND_URL="http://localhost:5173"
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Cloudinary (Dashboard > Settings > API Keys). Todos los archivos se guardan aquí.
# La API key necesita un rol con permiso de subida (p. ej. Master admin) y la cuenta debe tener
# activo Settings > Security > "Allow delivery of PDF and ZIP files" para servir mapas en PDF.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="eventix"

# Correo saliente (Gmail: usa una "contraseña de aplicación", no la contraseña de la cuenta).
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_SECURE="true"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="EvenTix <correo@dominio.com>"
