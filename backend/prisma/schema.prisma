generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  passwordHash            String
  nombre                  String
  apellido                String?
  /// Forma canónica (ver normalizePhone); único para evitar cuentas duplicadas.
  telefono                String?                 @unique
  /// Forma canónica (ver normalizeDocument); único para evitar cuentas duplicadas.
  documento               String?                 @unique
  fechaNac                DateTime?
  fotoUrl                 String?
  fotoPublicId            String?
  preferencias            Json?
  activo                  Boolean                 @default(true)
  /// Baja realizada por un administrador; la fila se conserva por el historial de eventos y compras.
  eliminadoAt             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  accesosRegistrados      AccesoEvento[]          @relation("EncargadoAccesos")
  accesosRechazados       AccesoRechazo[]         @relation("EncargadoRechazos")
  archivos                Archivo[]
  ayudantesCreados        AyudanteNegocio[]       @relation("JefeAyudantes")
  ayudanteDe              AyudanteNegocio?
  compras                 CompraEntrada[]
  entradas                Entrada[]               @relation("TitularEntrada")
  eventosOrganizados      Evento[]                @relation("OrganizadorEventos")
  incidenciasReportadas   IncidenciaRecarga[]     @relation("RecargadorIncidencias")
  incidenciasResueltas    IncidenciaRecarga[]     @relation("IncidenciasResueltas")
  invitacionesCreadas     InvitacionUsuario[]     @relation("InvitacionesCreadas")
  liquidacionesAprobadas  LiquidacionEvento[]     @relation("AdminLiquidaciones")
  liquidacionesEntregadas LiquidacionEvento[]     @relation("EntregaLiquidaciones")
  manillasEntregadas      Manilla[]               @relation("SupervisorManillas")
  negocio                 Negocio?
  puntosRetiroAsignados   SupervisorPuntoRetiro[]
  resetTokens             PasswordResetToken[]
  reembolsos              ReembolsoEntrada[]
  saldosEvento            SaldoEvento[]
  solicitudes             SolicitudEvento[]       @relation("OrganizadorSolicitudes")
  solicitudesNegocioResp  SolicitudNegocio[]
  staffAsignaciones       StaffEvento[]
  transaccionesOperadas   TransaccionSaldo[]      @relation("OperadorTransacciones")
  transaccionesSaldo      TransaccionSaldo[]      @relation("UsuarioTransacciones")
  roles                   UsuarioRol[]
  ventasRealizadas        Venta[]                 @relation("AyudanteVentas")
}

/// Cuenta pendiente creada por un admin; el Usuario solo existe cuando el invitado acepta.
model InvitacionUsuario {
  id          String           @id @default(cuid())
  email       String
  nombre      String
  apellido    String?
  telefono    String?
  role        Role
  tokenHash   String           @unique
  expiresAt   DateTime
  estado      InvitacionEstado @default(PENDIENTE)
  creadoPorId String
  aceptadaAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  creadoPor   Usuario          @relation("InvitacionesCreadas", fields: [creadoPorId], references: [id])

  @@index([email, estado])
  @@index([creadoPorId], map: "InvitacionUsuario_creadoPorId_fkey")
}

model UsuarioRol {
  id        String  @id @default(cuid())
  usuarioId String
  role      Role
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, role])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  usuarioId String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId], map: "PasswordResetToken_usuarioId_fkey")
}

model StaffEvento {
  id        String   @id @default(cuid())
  usuarioId String
  eventoId  String
  role      Role
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  evento    Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, eventoId, role])
  @@index([eventoId], map: "StaffEvento_eventoId_fkey")
}

model SolicitudEvento {
  id            String          @id @default(cuid())
  organizadorId String
  nombreEvento  String
  descripcion   String          @db.Text
  ubicacion     String
  ubicacionUrl  String?         @db.VarChar(500)
  capacidad     Int?
  empresa       String?
  /// Día de inicio; fechaFin solo existe si el evento dura varios días.
  fechaInicio   DateTime        @db.Date
  fechaFin      DateTime?       @db.Date
  /// Mismo horario para todos los días del evento (HH:mm).
  horaInicio    String          @db.VarChar(5)
  horaFin       String          @db.VarChar(5)
  mapaUrl       String?
  mapaNombre    String?
  estado        SolicitudEstado @default(PENDIENTE)
  observaciones String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  evento        Evento?
  mapHistory    MapaHistorial[]
  organizador   Usuario         @relation("OrganizadorSolicitudes", fields: [organizadorId], references: [id])

  @@index([organizadorId], map: "SolicitudEvento_organizadorId_fkey")
}

model Evento {
  id                   String               @id @default(cuid())
  solicitudId          String?              @unique
  organizadorId        String
  titulo               String
  descripcion          String               @db.Text
  fotoUrl              String?
  fotoPublicId         String?
  ubicacion            String
  ubicacionUrl         String?              @db.VarChar(500)
  /// Lista de nombres de servicios: ["Estacionamiento", "Baños", ...]
  servicios            Json?
  /// { apertura: "HH:mm", cierre: "HH:mm", actividades: [{ hora: "HH:mm", actividad: string }] }
  /// apertura y cierre son siempre la horaInicio y horaFin de sus FechaEvento.
  cronograma           Json?
  tipoAcceso           TipoAcceso           @default(QR_DIGITAL)
  estado               EventoEstado         @default(BORRADOR)
  mapaUrl              String?
  capacidad            Int?
  puntoRetiroManilla   String?
  horarioRetiroManilla String?
  /// QR al que se transfiere el pago de las entradas (HU-012).
  qrPagoUrl            String?              @db.VarChar(500)
  qrPagoPublicId       String?
  instruccionesPago    String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  accesos              AccesoEvento[]
  accesosRechazados    AccesoRechazo[]
  categorias           CategoriaEntrada[]
  compras              CompraEntrada[]
  entradas             Entrada[]
  organizador          Usuario              @relation("OrganizadorEventos", fields: [organizadorId], references: [id])
  solicitud            SolicitudEvento?     @relation(fields: [solicitudId], references: [id])
  fechas               FechaEvento[]
  incidenciasRecarga   IncidenciaRecarga[]
  liquidacion          LiquidacionEvento?
  manillas             Manilla[]
  mapHistory           MapaHistorial[]
  negocios             Negocio[]
  puntosRetiro         PuntoRetiroManilla[]
  saldos               SaldoEvento[]
  solicitudesNegocio   SolicitudNegocio[]
  staff                StaffEvento[]
  transacciones        TransaccionSaldo[]
  ventas               Venta[]

  @@index([organizadorId], map: "Evento_organizadorId_fkey")
}

model FechaEvento {
  id         String           @id @default(cuid())
  eventoId   String
  fecha      DateTime         @db.Date
  horaInicio String           @db.VarChar(5)
  horaFin    String           @db.VarChar(5)
  accesos    AccesoEvento[]
  rechazos   AccesoRechazo[]
  categorias CategoriaFecha[]
  entradas   Entrada[]
  evento     Evento           @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, fecha])
}

model CategoriaEntrada {
  id                String              @id @default(cuid())
  eventoId          String
  nombre            String
  precio            Decimal             @db.Decimal(10, 2)
  /// Porcentaje de descuento sobre el precio (0 = sin descuento).
  descuento         Int                 @default(0)
  /// Lista de beneficios: ["Acceso preferencial", ...]
  beneficios        Json?
  /// Entradas disponibles; el pool de códigos QR se mantiene con este mismo tamaño.
  cupo              Int
  evento            Evento              @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  fechasDisponibles CategoriaFecha[]
  itemsCompra       CompraEntradaItem[]
  entradas          Entrada[]
  ticketsPool       TicketPool[]

  @@index([eventoId], map: "CategoriaEntrada_eventoId_fkey")
}

model CategoriaFecha {
  id          String           @id @default(cuid())
  categoriaId String
  fechaId     String
  disponible  Boolean          @default(true)
  categoria   CategoriaEntrada @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  fecha       FechaEvento      @relation(fields: [fechaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, fechaId])
  @@index([fechaId], map: "CategoriaFecha_fechaId_fkey")
}

model MapaHistorial {
  id          String           @id @default(cuid())
  solicitudId String?
  eventoId    String?
  mapaUrl     String
  mapaNombre  String?
  tipo        MapChangeTipo
  nota        String?
  createdAt   DateTime         @default(now())
  evento      Evento?          @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  solicitud   SolicitudEvento? @relation(fields: [solicitudId], references: [id], onDelete: Cascade)

  @@index([eventoId], map: "MapaHistorial_eventoId_fkey")
  @@index([solicitudId], map: "MapaHistorial_solicitudId_fkey")
}

/// Pool de códigos QR pregenerados (Sprint 1 HU-041); asignación a una Entrada en Sprint 2.
/// codigoQr es el contenido que lleva el QR; la imagen se genera en la API al listar.
model TicketPool {
  id          String           @id @default(cuid())
  categoriaId String
  codigoQr    String           @unique
  codigo      String           @unique
  estado      String           @default("GENERADO")
  createdAt   DateTime         @default(now())
  entrada     Entrada?
  categoria   CategoriaEntrada @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@index([categoriaId], map: "TicketPool_categoriaId_fkey")
}

model CompraEntrada {
  id             String              @id @default(cuid())
  usuarioId      String
  eventoId       String
  estado         CompraEstado        @default(PENDIENTE)
  montoTotal     Decimal             @db.Decimal(12, 2)
  comprobanteUrl String?
  observaciones  String?             @db.Text
  revisadoPorId  String?
  revisadoAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  evento         Evento              @relation(fields: [eventoId], references: [id])
  usuario        Usuario             @relation(fields: [usuarioId], references: [id])
  items          CompraEntradaItem[]
  entradas       Entrada[]
  pago           PagoQR?

  @@index([eventoId], map: "CompraEntrada_eventoId_fkey")
  @@index([usuarioId], map: "CompraEntrada_usuarioId_fkey")
}

model CompraEntradaItem {
  id           String           @id @default(cuid())
  compraId     String
  categoriaId  String
  fechaId      String?
  cantidad     Int              @default(1)
  precioUnit   Decimal          @db.Decimal(10, 2)
  /// Entrada para un tercero (HU-011): siempre de una unidad, con sus datos de contacto.
  paraNombre   String?
  paraEmail    String?
  paraTelefono String?
  /// Entrada emitida para el tercero al aprobar la compra; permite asignársela cuando cree su cuenta.
  entradaId    String?          @unique
  categoria    CategoriaEntrada @relation(fields: [categoriaId], references: [id])
  compra       CompraEntrada    @relation(fields: [compraId], references: [id], onDelete: Cascade)
  entrada      Entrada?         @relation(fields: [entradaId], references: [id], onDelete: SetNull)

  @@index([categoriaId], map: "CompraEntradaItem_categoriaId_fkey")
  @@index([compraId], map: "CompraEntradaItem_compraId_fkey")
}

model PagoQR {
  id             String        @id @default(cuid())
  compraId       String        @unique
  referencia     String?
  comprobanteUrl String?
  monto          Decimal       @db.Decimal(12, 2)
  createdAt      DateTime      @default(now())
  compra         CompraEntrada @relation(fields: [compraId], references: [id], onDelete: Cascade)
}

model Entrada {
  id           String             @id @default(cuid())
  compraId     String?
  eventoId     String
  categoriaId  String
  fechaId      String?
  titularId    String?
  ticketPoolId String?            @unique
  codigoQr     String             @unique
  codigo       String             @unique
  estado       EntradaEstado      @default(GENERADA)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  accesos      AccesoEvento[]
  rechazos     AccesoRechazo[]
  credencial   Credencial?
  categoria    CategoriaEntrada   @relation(fields: [categoriaId], references: [id])
  compra       CompraEntrada?     @relation(fields: [compraId], references: [id])
  evento       Evento             @relation(fields: [eventoId], references: [id])
  fecha        FechaEvento?       @relation(fields: [fechaId], references: [id])
  ticketPool   TicketPool?        @relation(fields: [ticketPoolId], references: [id])
  titular      Usuario?           @relation("TitularEntrada", fields: [titularId], references: [id])
  manilla      Manilla?
  reembolso    ReembolsoEntrada?
  itemCompra   CompraEntradaItem?

  @@index([categoriaId], map: "Entrada_categoriaId_fkey")
  @@index([compraId], map: "Entrada_compraId_fkey")
  @@index([eventoId], map: "Entrada_eventoId_fkey")
  @@index([fechaId], map: "Entrada_fechaId_fkey")
  @@index([titularId], map: "Entrada_titularId_fkey")
}

model ReembolsoEntrada {
  id        String          @id @default(cuid())
  entradaId String          @unique
  usuarioId String
  motivo    String?         @db.Text
  estado    ReembolsoEstado @default(SOLICITADO)
  monto     Decimal?        @db.Decimal(12, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  entrada   Entrada         @relation(fields: [entradaId], references: [id])
  usuario   Usuario         @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId], map: "ReembolsoEntrada_usuarioId_fkey")
}

model Credencial {
  id        String   @id @default(cuid())
  entradaId String   @unique
  codigoQr  String   @unique
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  entrada   Entrada  @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  manilla   Manilla?
}

model Manilla {
  id             String              @id @default(cuid())
  eventoId       String
  entradaId      String?             @unique
  credencialId   String?             @unique
  codigoFisico   String
  vinculada      Boolean             @default(false)
  vinculadaAt    DateTime?
  puntoRetiroId  String?
  /// Supervisor que entregó la manilla y confirmó la vinculación (HU-015, HU-053).
  entregadaPorId String?
  createdAt      DateTime            @default(now())
  credencial     Credencial?         @relation(fields: [credencialId], references: [id])
  entrada        Entrada?            @relation(fields: [entradaId], references: [id])
  entregadaPor   Usuario?            @relation("SupervisorManillas", fields: [entregadaPorId], references: [id])
  evento         Evento              @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  puntoRetiro    PuntoRetiroManilla? @relation(fields: [puntoRetiroId], references: [id])

  @@unique([eventoId, codigoFisico])
  @@index([entregadaPorId], map: "Manilla_entregadaPorId_fkey")
  @@index([puntoRetiroId], map: "Manilla_puntoRetiroId_fkey")
}

model PuntoRetiroManilla {
  id           String                  @id @default(cuid())
  eventoId     String
  nombre       String
  ubicacion    String?
  horario      String?
  activo       Boolean                 @default(true)
  manillas     Manilla[]
  evento       Evento                  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  supervisores SupervisorPuntoRetiro[]

  @@index([eventoId], map: "PuntoRetiroManilla_eventoId_fkey")
}

/// Supervisores (rol ENCARGADO_ACCESO) que entregan manillas en un punto. Quitar a alguien
/// lo desactiva y conserva la fila, porque sus entregas pasadas siguen apuntando a él.
model SupervisorPuntoRetiro {
  id            String             @id @default(cuid())
  puntoRetiroId String
  usuarioId     String
  activo        Boolean            @default(true)
  createdAt     DateTime           @default(now())
  puntoRetiro   PuntoRetiroManilla @relation(fields: [puntoRetiroId], references: [id], onDelete: Cascade)
  usuario       Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([puntoRetiroId, usuarioId])
  @@index([usuarioId], map: "SupervisorPuntoRetiro_usuarioId_fkey")
}

model AccesoEvento {
  id             String       @id @default(cuid())
  eventoId       String
  entradaId      String
  fechaId        String?
  encargadoId    String?
  tipo           AccesoTipo
  fotoIngresoUrl String?
  createdAt      DateTime     @default(now())
  encargado      Usuario?     @relation("EncargadoAccesos", fields: [encargadoId], references: [id])
  entrada        Entrada      @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  evento         Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  fecha          FechaEvento? @relation(fields: [fechaId], references: [id])

  @@index([encargadoId], map: "AccesoEvento_encargadoId_fkey")
  @@index([entradaId], map: "AccesoEvento_entradaId_fkey")
  @@index([eventoId], map: "AccesoEvento_eventoId_fkey")
  @@index([fechaId], map: "AccesoEvento_fechaId_fkey")
}

/// HU-046: el supervisor vio que la persona no coincide con la foto del primer ingreso y no la dejó pasar.
model AccesoRechazo {
  id          String       @id @default(cuid())
  eventoId    String
  entradaId   String
  fechaId     String?
  encargadoId String?
  /// Puerta en la que se rechazó: ENTRADA o SALIDA.
  sentido     String       @db.VarChar(10)
  motivo      String?      @db.VarChar(300)
  createdAt   DateTime     @default(now())
  encargado   Usuario?     @relation("EncargadoRechazos", fields: [encargadoId], references: [id], onDelete: SetNull)
  entrada     Entrada      @relation(fields: [entradaId], references: [id], onDelete: Cascade)
  evento      Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  fecha       FechaEvento? @relation(fields: [fechaId], references: [id], onDelete: SetNull)

  @@index([eventoId, fechaId])
  @@index([entradaId])
  @@index([encargadoId])
  @@index([fechaId], map: "AccesoRechazo_fechaId_fkey")
}

model SaldoEvento {
  id            String             @id @default(cuid())
  usuarioId     String
  eventoId      String
  saldo         Decimal            @default(0.00) @db.Decimal(12, 2)
  updatedAt     DateTime           @updatedAt
  evento        Evento             @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario       Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  transacciones TransaccionSaldo[]

  @@unique([usuarioId, eventoId])
  @@index([eventoId], map: "SaldoEvento_eventoId_fkey")
}

model TransaccionSaldo {
  id              String               @id @default(cuid())
  saldoEventoId   String
  usuarioId       String
  eventoId        String
  operadorId      String?
  tipo            TipoTransaccionSaldo
  monto           Decimal              @db.Decimal(12, 2)
  saldoResultante Decimal              @db.Decimal(12, 2)
  estado          EstadoTransaccion    @default(COMPLETADA)
  nota            String?
  ventaId         String?
  evidenciaUrl    String?
  createdAt       DateTime             @default(now())
  evento          Evento               @relation(fields: [eventoId], references: [id])
  operador        Usuario?             @relation("OperadorTransacciones", fields: [operadorId], references: [id])
  saldoEvento     SaldoEvento          @relation(fields: [saldoEventoId], references: [id], onDelete: Cascade)
  usuario         Usuario              @relation("UsuarioTransacciones", fields: [usuarioId], references: [id])
  venta           Venta?               @relation(fields: [ventaId], references: [id])
  incidencias     IncidenciaRecarga[]

  @@index([eventoId], map: "TransaccionSaldo_eventoId_fkey")
  @@index([operadorId], map: "TransaccionSaldo_operadorId_fkey")
  @@index([saldoEventoId], map: "TransaccionSaldo_saldoEventoId_fkey")
  @@index([usuarioId], map: "TransaccionSaldo_usuarioId_fkey")
  @@index([ventaId], map: "TransaccionSaldo_ventaId_fkey")
}

/// HU-047: problema con una recarga reportado por el recargador; el administrador lo revisa y lo resuelve.
model IncidenciaRecarga {
  id            String                @id @default(cuid())
  transaccionId String
  eventoId      String
  recargadorId  String
  tipo          TipoIncidenciaRecarga
  descripcion   String                @db.VarChar(500)
  estado        EstadoIncidencia      @default(ABIERTA)
  resolucion    String?               @db.VarChar(500)
  resueltaPorId String?
  resueltaAt    DateTime?
  createdAt     DateTime              @default(now())
  evento        Evento                @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  recargador    Usuario               @relation("RecargadorIncidencias", fields: [recargadorId], references: [id], onDelete: Cascade)
  resueltaPor   Usuario?              @relation("IncidenciasResueltas", fields: [resueltaPorId], references: [id], onDelete: SetNull)
  transaccion   TransaccionSaldo      @relation(fields: [transaccionId], references: [id], onDelete: Cascade)

  @@index([transaccionId])
  @@index([eventoId])
  @@index([recargadorId])
  @@index([resueltaPorId])
  @@index([estado])
}

model Negocio {
  id                     String                @id @default(cuid())
  duenoId                String                @unique
  nombre                 String
  descripcion            String?               @db.Text
  activo                 Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  ciudad                 String?
  direccion              String?
  emailContacto          String?
  logoPublicId           String?
  logoUrl                String?
  matriculaComercio      String?
  nit                    String?               @unique
  razonSocial            String?
  representanteDocumento String?
  representanteNombre    String?
  rubro                  Negocio_rubro?
  telefono               String?
  tipoSociedad           Negocio_tipoSociedad?
  /// Columna anterior a SolicitudNegocio; la participación en eventos se lee de las solicitudes ACEPTADAS.
  eventoId               String?
  ayudantes              AyudanteNegocio[]
  dueno                  Usuario               @relation(fields: [duenoId], references: [id])
  evento                 Evento?               @relation(fields: [eventoId], references: [id])
  productos              Producto[]
  retiros                RetiroGanancias[]
  roles                  RolNegocio[]
  solicitudes            SolicitudNegocio[]
  ventas                 Venta[]

  @@index([eventoId], map: "Negocio_eventoId_fkey")
}

/// Participación de un negocio en un evento; el administrador la acepta o rechaza.
model SolicitudNegocio {
  id              String                  @id @default(cuid())
  negocioId       String
  eventoId        String
  estado          SolicitudNegocio_estado @default(PENDIENTE)
  mensaje         String?                 @db.Text
  respuesta       String?                 @db.Text
  respondidoPorId String?
  respondidoAt    DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  evento          Evento                  @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  negocio         Negocio                 @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  respondidoPor   Usuario?                @relation(fields: [respondidoPorId], references: [id])

  @@index([eventoId, estado])
  @@index([negocioId, eventoId])
  @@index([respondidoPorId])
}

model Producto {
  id           String             @id @default(cuid())
  negocioId    String
  nombre       String
  precio       Decimal            @db.Decimal(10, 2)
  descripcion  String?            @db.VarChar(500)
  activo       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  categoria    Producto_categoria @default(OTRO)
  fotoPublicId String?
  fotoUrl      String?
  /// Unidades disponibles; null = el producto no controla stock.
  stock        Int?
  detalles     DetalleVenta[]
  negocio      Negocio            @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId], map: "Producto_negocioId_fkey")
}

/// Rol que el jefe de negocio define para sus ayudantes (p. ej. "Cajero").
model RolNegocio {
  id          String            @id @default(cuid())
  negocioId   String
  nombre      String            @db.VarChar(50)
  descripcion String            @db.VarChar(255)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  ayudantes   AyudanteNegocio[]
  negocio     Negocio           @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@unique([negocioId, nombre])
}

model AyudanteNegocio {
  id           String                 @id @default(cuid())
  negocioId    String
  usuarioId    String                 @unique
  jefeId       String
  createdAt    DateTime               @default(now())
  /// Solo un ayudante ACTIVO puede cobrar en el POS.
  estado       AyudanteNegocio_estado @default(PENDIENTE_INVITACION)
  rolId        String?
  activo       Boolean                @default(true)
  rolFuncion   String                 @default("cajero")
  jefe         Usuario                @relation("JefeAyudantes", fields: [jefeId], references: [id])
  negocio      Negocio                @relation(fields: [negocioId], references: [id], onDelete: Cascade)
  rol          RolNegocio?            @relation(fields: [rolId], references: [id], onDelete: Restrict)
  usuario      Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  invitaciones InvitacionAyudante[]

  @@index([jefeId], map: "AyudanteNegocio_jefeId_fkey")
  @@index([negocioId], map: "AyudanteNegocio_negocioId_fkey")
  @@index([rolId])
}

model InvitacionAyudante {
  id         String                    @id @default(cuid())
  ayudanteId String
  tokenHash  String                    @unique
  expiraAt   DateTime
  aceptadaAt DateTime?
  estado     InvitacionAyudante_estado @default(PENDIENTE)
  createdAt  DateTime                  @default(now())
  ayudante   AyudanteNegocio           @relation(fields: [ayudanteId], references: [id], onDelete: Cascade)

  @@index([ayudanteId, estado])
}

model Venta {
  id            String             @id @default(cuid())
  negocioId     String
  eventoId      String
  ayudanteId    String
  clienteId     String?
  entradaId     String?
  total         Decimal            @db.Decimal(12, 2)
  createdAt     DateTime           @default(now())
  detalles      DetalleVenta[]
  transacciones TransaccionSaldo[]
  ayudante      Usuario            @relation("AyudanteVentas", fields: [ayudanteId], references: [id])
  evento        Evento             @relation(fields: [eventoId], references: [id])
  negocio       Negocio            @relation(fields: [negocioId], references: [id])

  @@index([ayudanteId], map: "Venta_ayudanteId_fkey")
  @@index([eventoId], map: "Venta_eventoId_fkey")
  @@index([negocioId], map: "Venta_negocioId_fkey")
}

model DetalleVenta {
  id         String   @id @default(cuid())
  ventaId    String
  productoId String
  cantidad   Int      @default(1)
  precioUnit Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
  producto   Producto @relation(fields: [productoId], references: [id])
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([productoId], map: "DetalleVenta_productoId_fkey")
  @@index([ventaId], map: "DetalleVenta_ventaId_fkey")
}

model RetiroGanancias {
  id           String   @id @default(cuid())
  negocioId    String
  monto        Decimal  @db.Decimal(12, 2)
  estado       String   @default("SOLICITADO")
  evidenciaUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  negocio      Negocio  @relation(fields: [negocioId], references: [id], onDelete: Cascade)

  @@index([negocioId], map: "RetiroGanancias_negocioId_fkey")
}

model LiquidacionEvento {
  id             String            @id @default(cuid())
  eventoId       String            @unique
  montoTotal     Decimal           @db.Decimal(14, 2)
  estado         LiquidacionEstado @default(PENDIENTE)
  aprobadoPorId  String?
  aprobadoAt     DateTime?
  entregadoPorId String?
  entregadoAt    DateTime?
  evidenciaUrl   String?
  nota           String?           @db.Text
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  aprobadoPor    Usuario?          @relation("AdminLiquidaciones", fields: [aprobadoPorId], references: [id])
  entregadoPor   Usuario?          @relation("EntregaLiquidaciones", fields: [entregadoPorId], references: [id])
  evento         Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([aprobadoPorId], map: "LiquidacionEvento_aprobadoPorId_fkey")
  @@index([entregadoPorId], map: "LiquidacionEvento_entregadoPorId_fkey")
}

model Archivo {
  id        String   @id @default(cuid())
  usuarioId String?
  url       String
  tipo      String
  nombre    String?
  meta      Json?
  createdAt DateTime @default(now())
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId], map: "Archivo_usuarioId_fkey")
}

